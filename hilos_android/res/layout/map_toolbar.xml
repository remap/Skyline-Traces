<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/map_toolbar" android:layout_width="fill_parent"
	android:layout_height="fill_parent" android:padding="20px">
	<LinearLayout android:id="@+id/bg_map_toolbar"
		android:layout_width="wrap_content" android:layout_height="72px"
		android:orientation="horizontal" android:layout_alignParentBottom="true"
		android:layout_centerHorizontal="true">
		<Button android:id="@+id/map_zoomin" android:layout_width="48px"
			android:layout_height="60px" />
		<edu.ucla.tft.hilos.Separator
			android:layout_width="16px" android:layout_height="60px" />
		<Button android:id="@+id/map_home" android:layout_width="48px"
			android:layout_height="60px" />
		<edu.ucla.tft.hilos.Separator
			android:layout_width="16px" android:layout_height="60px" />
		<Button android:id="@+id/map_info" android:layout_width="48px"
			android:layout_height="60px" />
		<Button android:id="@+id/map_help" android:layout_width="48px"
			android:layout_height="60px" />
		<edu.ucla.tft.hilos.Separator
			android:layout_width="16px" android:layout_height="60px" />
		<Button android:id="@+id/map_pin" android:layout_width="48px"
			android:layout_height="60px" />
		<edu.ucla.tft.hilos.Separator
			android:layout_width="16px" android:layout_height="60px" />
		<Button android:id="@+id/map_zoomout" android:layout_width="48px"
			android:layout_height="60px" />
	</LinearLayout>
</RelativeLayout>