<?xml version="1.0" encoding="utf-8"?>
<edu.ucla.tft.hilos.HilosView
	xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/HilosView"
	android:layout_width="fill_parent" android:layout_height="fill_parent"
	android:padding="20sp">
	<RelativeLayout android:layout_width="fill_parent"
		android:layout_height="fill_parent">
		<Button android:id="@+id/start" android:text="START" android:layout_width="wrap_content"
			android:layout_height="wrap_content" android:layout_alignParentTop="true"
			android:layout_alignParentRight="true" />
        <Button android:id="@+id/settings" android:text="Settings" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true" />
	</RelativeLayout>
</edu.ucla.tft.hilos.HilosView>
