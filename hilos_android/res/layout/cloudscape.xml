<?xml version="1.0" encoding="utf-8"?>
<edu.ucla.tft.hilos.cloudscape.Cloudscape
	xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/cloudscape"
	android:layout_width="fill_parent" android:layout_height="fill_parent"
	android:paddingLeft="200sp" android:paddingTop="25sp"
	android:paddingRight="25sp" android:paddingBottom="25sp">
	<LinearLayout android:id="@+id/cloudscape_info"
		android:layout_width="fill_parent" android:layout_height="fill_parent"
		android:orientation="vertical" android:visibility="invisible">
		<LinearLayout android:layout_width="fill_parent"
			android:layout_height="25sp" android:orientation="horizontal">
			<TextView android:id="@+id/cloudscape_info_title"
				android:layout_width="fill_parent" android:layout_height="fill_parent"
				android:layout_weight="1" android:textColor="#fff" android:textSize="12sp"
				android:gravity="left" />
			<Button android:id="@+id/cloudscape_info_viewimage"
				android:layout_width="wrap_content" android:layout_height="wrap_content"
				android:textSize="10sp" android:text="View all images" />
		</LinearLayout>
		<WebView android:id="@+id/cloudscape_info_webview"
			android:layout_width="fill_parent" android:layout_height="fill_parent"
			android:layout_weight="1" />
	</LinearLayout>
</edu.ucla.tft.hilos.cloudscape.Cloudscape>