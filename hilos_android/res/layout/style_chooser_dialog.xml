<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent" android:layout_height="fill_parent"
	android:padding="10sp">
	<LinearLayout android:layout_width="fill_parent"
		android:layout_height="fill_parent" android:orientation="vertical">
		<LinearLayout android:layout_width="fill_parent"
			android:layout_height="48sp" android:orientation="horizontal">
			<Button android:id="@+id/style_prev" android:layout_width="48sp"
				android:layout_height="fill_parent" style="@style/PrevStyleButton" />
			<TextView android:id="@+id/style_title"
				android:layout_width="fill_parent" android:layout_height="fill_parent"
				android:layout_weight="1" android:textColor="#fff" android:textSize="18sp"
				android:gravity="center" android:shadowColor="#000"
				android:shadowRadius="1" android:shadowDx="1" android:shadowDy="1" />
			<Button android:id="@+id/style_next" android:layout_width="48sp"
				android:layout_height="fill_parent" style="@style/NextStyleButton" />
		</LinearLayout>
		<ImageView android:id="@+id/styleIconView"
			android:layout_width="fill_parent" android:layout_height="fill_parent"
			android:layout_weight="1" />
	</LinearLayout>
</FrameLayout>